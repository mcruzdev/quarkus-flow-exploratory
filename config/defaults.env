# Default configuration for the exploratory automation suite.
# Sourced by scripts/areas/*.sh. Override any of these via environment
# variables at invocation time instead of editing this file, e.g.:
#
#   QF_VERSION=1.2.0 ./scripts/areas/area-a.sh
#
# The two knobs most likely to need bumping over time are QF_VERSION and
# QUARKUS_PLATFORM_VERSION, since the guide this automates is pinned to a
# released Quarkus Flow version that will drift from quarkus-flow's main
# branch (currently moving towards 1.2.0).

QF_VERSION="${QF_VERSION:-1.1.0}"
QUARKUS_PLATFORM_VERSION="${QUARKUS_PLATFORM_VERSION:-3.37.4}"

TEST_GROUP_ID="${TEST_GROUP_ID:-org.acme}"
TEST_ARTIFACT_ID="${TEST_ARTIFACT_ID:-hello-flow}"

APP_PORT="${APP_PORT:-8080}"

READY_TIMEOUT_SECONDS="${READY_TIMEOUT_SECONDS:-120}"
LIVE_RELOAD_TIMEOUT_SECONDS="${LIVE_RELOAD_TIMEOUT_SECONDS:-30}"
LIVE_RELOAD_POLL_INTERVAL_SECONDS="${LIVE_RELOAD_POLL_INTERVAL_SECONDS:-2}"
HTTP_TIMEOUT_SECONDS="${HTTP_TIMEOUT_SECONDS:-10}"
GRACEFUL_STOP_SECONDS="${GRACEFUL_STOP_SECONDS:-10}"

RETRY_MAX_ATTEMPTS="${RETRY_MAX_ATTEMPTS:-3}"
RETRY_DELAY_SECONDS="${RETRY_DELAY_SECONDS:-5}"
